# ecportal — 環境變數範例 (本地開發用，真值只在 Vercel env)
# BUILD.md §1/§2：apikey 只存 server，永不回前端/URL/QR

# 平台層 (ADMIN)
# TROOP_0082_BACKEND=https://script.google.com/macros/s/XXXX/exec
# TROOP_0082_APIKEY=xxx
# SCOUT_ADMIN_API=xxx
# EC_SUPER_KEY=xxx
# SESSION_SECRET=xxx

# 旅層 (TROOP_OPS 內亦有一份 cache)
# TROOP_MODULES={"notice":true,"calendar":true,"album":true,"finance":true,"progress":true}

# 推送 (圖書館 VAPID 公鑰，系統 service worker 用同一把)
# VAPID_PUBLIC_KEY=xxx

# 本檔可提交，.env* 真檔已在 .gitignore/.vercelignore
