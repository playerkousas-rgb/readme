# ============================================================
# .env.example — 只寫 key 名，永遠唔寫值（A1）
# 抄一份做 .env.local（本機）＋ 喺 Vercel Dashboard 設 Production/Preview
# ============================================================

# --- Session / 簽名（Production 同 Preview 要兩條唔同）---
SESSION_SECRET=

# --- 隱藏超管（只設 Production；Preview 留空 = /api/super 回 404）---
SUPER_KEY=
SUPER_VERIFY_URL=https://<app>.vercel.app/api/super

# --- 單位 GAS 接駁（server-only，永不入前端 / URL / QR）---
UNIT_DEMO_BACKEND=https://script.google.com/macros/s/<id>/exec
UNIT_DEMO_APIKEY=
UNIT_DEMO_NAME=示範單位

# --- Gemini / AI（server-side only）---
# AI Studio Build 自動注入嘅同名 secret；ZIP / 自己 host 時要手動設（docs/14 §1）。
# 千祈唔好用 NEXT_PUBLIC_ / VITE_ 前綴；vite.config 唔好用 loadEnv(...,'')。
GEMINI_API_KEY=

# --- Supabase ---
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=

# --- Web Push（VAPID public 可以公開；private 只喺 server）---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ============================================================
# 開機自檢（F12）：上面任何一條缺 = 拒絕敏感 action，唔係照跑。
# 換 key = 三處同步（F16）：下游重生 → 上游重新登記 → Vercel env + Redeploy
# ============================================================
