# — ecportal 極簡 .gitignore — 只忽略真正不應入庫的產物，唔靠忽視掩蓋肥胖
# 依賴
node_modules/
.pnp/
.pnp.js

# Vercel / 建置產物 (本地快取，重建即可得，絕不入庫)
.vercel/
dist/
out/
build/
.next/
.nuxt/
.output/
.cache/
.parcel-cache/
.turbo/
.vite/
coverage/

# 開發備份 / 暫存 / 日誌 (瘦身重點: 防止 *.bak/*.tmp/*.old 污染倉庫)
*.bak
*.tmp
*.old
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# 上傳測試資料夾 (若日後有 uploads/，本機測試檔不入庫；生產用 Drive/Sheet)
uploads/
tmp/
temp/

# 環境機密 (永不入庫，Vercel env 才是單一真理)
.env
.env.*
!.env.example

# 編輯器
.vscode/
.idea/
*.code-workspace

# 其他快取
.eslintcache
.stylelintcache
